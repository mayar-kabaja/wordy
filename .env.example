# Frontend only. Both of these are public by design — the anon key is safe
# in the browser because Row Level Security decides what it can read.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# WORDORB_API_KEY and GROQ_API_KEY do NOT belong here. They go in Supabase
# secrets, not the frontend:
#   supabase secrets set WORDORB_API_KEY=...
#   supabase secrets set GROQ_API_KEY=...
